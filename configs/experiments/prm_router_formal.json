{
  "schema_version": 1,
  "dataset": {
    "name": "hitsmy/PRMBench_Preview",
    "split": "train",
    "pilot_path": "data/prm_router/feasibility_100.jsonl",
    "group_field": "original_question",
    "exclude_pilot_groups": true,
    "revision": "5cc7683d0ae5797f84d7aeac0607966f277c39e1"
  },
  "formal_splits": {
    "seed": 20260903,
    "train_examples": 600,
    "validation_examples": 200,
    "test_examples": 400,
    "correct_fraction": 0.5,
    "preserve_error_type_coverage": true
  },
  "models": {
    "base": {
      "name": "GAIR/ReasonEval-7B",
      "revision": "0a6556ef5c937bb17d265ba681b501fd60056cfe"
    },
    "primary_second_stage": {
      "name": "declare-lab/PathFinder-PRM-7B",
      "revision": "84a7412511836cb4ed74377d9c703eb5638d814c"
    },
    "alternative_second_stage": {
      "name": "GenPRM/GenPRM-1.5B",
      "revision": "a0fa69768f4524257e1730fec639aa7781c7fa82"
    }
  },
  "runtime": {
    "warmup_examples": 3,
    "exclude_model_loading": true,
    "cuda_synchronize": true,
    "same_hardware_required": true
  },
  "inference": {
    "reason_eval": {
      "development_output_threshold": 0.5
    },
    "pathfinder": {
      "threshold": 0.5,
      "max_input_tokens": 4096,
      "attention_implementation": "flash_attention_2",
      "load_in_4bit": false
    },
    "genprm": {
      "seed": 42,
      "max_analysis_tokens": 256,
      "max_input_tokens": 4096
    }
  },
  "base_threshold": {
    "selection_split": "validation",
    "selection_metric": "balanced_accuracy"
  },
  "routing": {
    "model": "logistic_regression",
    "primary_call_budget": 0.2,
    "secondary_call_budgets": [
      0.1,
      0.3,
      0.4,
      0.5,
      0.75,
      1
    ],
    "targets": [
      "base_failure",
      "beneficial",
      "beneficial_neutral_harmful"
    ],
    "pre_call_features": [
      "disprm_score",
      "distance_to_threshold",
      "disprm_predicted_correct",
      "step_position",
      "current_step",
      "total_steps",
      "question_characters",
      "disprm_input_tokens",
      "current_step_characters"
    ],
    "cost_aware": {
      "enabled": true,
      "cost_target": "pathfinder_runtime_seconds",
      "predictor_model": "ridge_regression",
      "predictor_features": [
        "disprm_input_tokens",
        "current_step",
        "total_steps",
        "step_position",
        "question_characters",
        "prefix_characters",
        "current_step_characters"
      ],
      "normalization": "divide_by_train_median_pathfinder_runtime",
      "lambda_h_candidates": [
        1,
        1.5,
        2
      ],
      "mu_candidates": [
        0,
        0.05,
        0.1,
        0.2,
        0.5
      ],
      "selection_split": "validation",
      "selection_rule": "maximize_validation_accuracy_at_primary_call_budget_then_minimize_measured_runtime",
      "ridge_alpha": 1
    },
    "random_baseline_seed": 20260903
  },
  "arbitration": {
    "overall_features": [
      "pathfinder_official_score",
      "pathfinder_gate_passed",
      "pathfinder_prediction"
    ],
    "fine_grained_features": [
      "pathfinder_math_probability",
      "pathfinder_consistency_probability"
    ]
  },
  "evaluation": {
    "primary_metric": "accuracy_at_20_percent_call_budget",
    "bootstrap_unit": "original_question",
    "bootstrap_samples": 2000,
    "confidence_level": 0.95,
    "same_hardware_runtime_required": true,
    "secondary_metrics": [
      "accuracy_vs_call_budget",
      "accuracy_vs_measured_runtime",
      "beneficial_replacement_rate",
      "harmful_replacement_rate",
      "captured_oracle_headroom"
    ],
    "diagnostic_analyses": {
      "confidence_bins": 5,
      "step_position_bins": 4,
      "input_length_bins": 4,
      "error_type_field": "classification",
      "error_type_analysis_only": true
    },
    "test_lock": {
      "require_protocol_frozen": true,
      "primary_comparison_locked_before_test": true,
      "no_test_based_hyperparameter_selection": true
    }
  }
}
